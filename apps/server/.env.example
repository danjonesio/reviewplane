# ReviewPlane control-plane server.
#
# Every setting is documented in docs/CONFIGURATION.md section 2 and is
# validated at startup. Commit this file, never a real secret
# (docs/DEVELOPMENT.md section 6). Any required value also accepts a
# <NAME>_FILE form naming a file that holds it, which is what a Compose
# deployment should use (docs/CONFIGURATION.md section 7).

# Required.
REVIEWPLANE_DATABASE_URL=postgres://reviewplane:reviewplane@127.0.0.1:5432/reviewplane

# Required. Stage 0 bootstrap administrator token (docs/ARCHITECTURE.md
# section 11). At least 32 characters. Generate with:
#   openssl rand -base64 48
# Prefer REVIEWPLANE_BOOTSTRAP_TOKEN_FILE=/run/secrets/bootstrap_token.
REVIEWPLANE_BOOTSTRAP_TOKEN=replace-me-with-at-least-32-random-characters

# HTTP API.
REVIEWPLANE_HOST=0.0.0.0
REVIEWPLANE_PORT=8080
REVIEWPLANE_LOG_LEVEL=info

# The organisation connectors enrol into. An enrolment token scoped to another
# organisation is refused with ENROLMENT_TOKEN_INVALID.
REVIEWPLANE_ORGANISATION_ID=org_default
REVIEWPLANE_ORGANISATION_NAME=ReviewPlane

# Connector listener. Mutually authenticated; see ADR-0014.
REVIEWPLANE_CONNECTOR_HOST=0.0.0.0
REVIEWPLANE_CONNECTOR_PORT=8443
REVIEWPLANE_CONNECTOR_TLS_HOSTS=localhost,127.0.0.1
# The wss base the registration response advertises. Set this when a reverse
# proxy or a published container port differs from the listen address.
# REVIEWPLANE_CONNECTOR_PUBLIC_URL=wss://agents.example.internal:8443
# Supply both, or neither, to use your own listener certificate instead of one
# issued from the connector certificate authority.
# REVIEWPLANE_CONNECTOR_TLS_CERT_FILE=/run/secrets/connector_listener.crt
# REVIEWPLANE_CONNECTOR_TLS_KEY_FILE=/run/secrets/connector_listener.key

# Device identity and enrolment tokens.
REVIEWPLANE_CONNECTOR_IDENTITY_TTL_DAYS=365
REVIEWPLANE_ENROLMENT_TOKEN_TTL_SECONDS=3600

# Heartbeat state machine (docs/DOMAIN_MODEL.md section 8).
REVIEWPLANE_CONNECTOR_HEARTBEAT_INTERVAL_SECONDS=15
REVIEWPLANE_CONNECTOR_DEGRADED_AFTER_SECONDS=45
REVIEWPLANE_CONNECTOR_DISCONNECTED_AFTER_SECONDS=90
REVIEWPLANE_CONNECTOR_MONITOR_INTERVAL_SECONDS=5
