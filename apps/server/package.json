{
  "name": "@reviewplane/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ReviewPlane control-plane server: HTTP API, connector enrolment and the connector control channel.",
  "main": "src/main.ts",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "pretypecheck": "pnpm --filter @reviewplane/protocol run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @reviewplane/protocol run build",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "@reviewplane/protocol": "workspace:*",
    "fastify": "^5.6.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "ws": "^8.21.1"
  }
}
