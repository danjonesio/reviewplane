{
  "name": "@reviewplane/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ReviewPlane web application: a Vite React single-page application served as static assets by the gateway (ADR-0011).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit && vite build && node scripts/check-self-contained.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "test": "node --conditions=development --test \"test/*.test.ts\"",
    "test:ui:container": "bash scripts/run-ui-tests.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@reviewplane/protocol": "workspace:*",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-router": "^1.135.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "playwright": "1.62.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5",
    "ws": "^8.21.1"
  }
}
