# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.astro/
*.tsbuildinfo

# Test artefacts
coverage/
coverage.out
*.test
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Environment and secrets — commit only *.example files
.env
.env.*
!.env.example
deploy/compose/secrets/*
!deploy/compose/secrets/.gitkeep
# TLS material the end-to-end scenario generates: a private authority, the
# gateway's key and certificate, and the trust bundles built from them.
deploy/compose/tls/*
!deploy/compose/tls/.gitkeep
!deploy/compose/tls/README.md
# The tunnel CA's private key. It is deliberately outside deploy/compose/tls,
# which is bind-mounted into two containers.
deploy/compose/ca/
# The connector configuration run.sh rewrites with the generated project id.
deploy/compose/connector-config.generated.yaml
# Evidence from an end-to-end run. It is attached to a pull request, not
# committed: it names generated identifiers that mean nothing on another run.
deploy/compose/e2e/evidence/
deploy/compose/e2e/evidence-install/

# Logs
*.log

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code local settings
.claude/settings.local.json

# Connector identity data written by a local test run
services/connector/reviewplane-connector
