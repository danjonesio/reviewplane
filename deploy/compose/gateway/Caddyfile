# ReviewPlane gateway configuration (`docs/ARCHITECTURE.md` section 4.1).
#
# Responsibilities, in the order that document lists them:
#
#   * TLS termination. Stage 0 uses Caddy's internal certificate authority so a
#     single-host install is HTTPS from the first boot; an operator who
#     terminates TLS elsewhere points `REVIEWPLANE_GATEWAY_TLS` at their own
#     certificate or puts their own proxy in front.
#   * Host and path routing: `/api` and `/internal`-free surface to the control
#     plane, everything else to the web application's static assets.
#   * WebSocket upgrades for `/ws`.
#   * Request-size and connection limits.
#   * Security headers.
#   * Web-application static asset serving.
#
# What it deliberately does not do: reach the browser worker, the tunnel
# gateway or PostgreSQL. `/internal/v1/*` is the worker channel
# (`docs/API.md` section 15.1) and is never routed from the internet.
#
# `deploy/compose/e2e/edge-smoke.sh` (`pnpm test:edge`) starts this file and
# asserts the four properties below that do not need an upstream: TLS, the
# document, the `/internal` refusal and the headers. Every other suite runs
# behind the gateway rather than through it, so without that gate a mistake in
# this file is invisible.
{
	admin off
	servers {
		# A live viewer's WebSocket is long-lived; a short idle timeout would
		# close a stream that is merely watching a quiet page.
		timeouts {
			read_body 30s
			idle 10m
		}
	}
}

# The site address carries a name, and that is load-bearing rather than
# cosmetic. A bare `:8443` binds the port but names no subject, so the
# certificate authority has nothing to issue for and every TLS handshake ends in
# an internal-error alert — the port is open, the process is running, and
# nothing below this line is ever reached. `localhost` is the single-host
# default the internal authority issues for; `REVIEWPLANE_GATEWAY_DOMAIN` names
# the real host anywhere else, and must agree with `REVIEWPLANE_PUBLIC_ORIGIN`
# on the control plane, which is the origin a live-view socket may be opened
# from.
{$REVIEWPLANE_GATEWAY_DOMAIN:localhost}:8443 {
	# `internal` is Caddy's own authority: HTTPS on first boot with nothing to
	# obtain. An operator with their own certificate sets
	# REVIEWPLANE_GATEWAY_TLS to the two paths the certificate and its key are
	# mounted at, separated by a space; an ACME account email is the third
	# accepted form. One who terminates TLS in front of this container fronts it
	# instead and leaves this alone.
	tls {$REVIEWPLANE_GATEWAY_TLS:internal}

	log {
		output stdout
		format console
		# docs/SECURITY.md section 18: no cookies, no authorization headers.
		level INFO
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		# The application loads nothing from another host, which is what makes
		# this policy strict enough to be worth having (ADR-0011).
		Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		-Server
	}

	# Every branch below is a `handle`, including the two that only answer, and
	# they are written in the order they are meant to be tried.
	#
	# This is not a style choice. `handle` blocks are mutually exclusive and are
	# evaluated in written order, but a bare `respond` is a different directive
	# and is sorted by Caddy's own directive order — which puts `handle` first.
	# A `respond /healthz` written above a catch-all `handle` is therefore
	# evaluated below it and never fires: the catch-all matches everything,
	# terminates, and the liveness route and the `/internal` refusal silently
	# become the single-page application document. Both did.

	# Liveness of the gateway itself. It answers without reaching the server, so
	# a failing control plane is diagnosed as a failing control plane.
	handle /healthz {
		respond "ok" 200
	}

	# The worker channel is internal. Refusing it here means a misconfigured
	# network cannot turn into an exposed worker API.
	handle /internal/* {
		respond 404
	}

	handle /api/* {
		request_body {
			# Artefact upload is the largest human-facing body (docs/API.md
			# section 15); everything else is metadata.
			max_size 24MB
		}
		reverse_proxy server:8080
	}

	# WebSocket upgrades. Caddy proxies the upgrade transparently; the size
	# bound belongs to the control plane, which applies the protocol's own
	# message limit (docs/API.md section 19).
	handle /ws/* {
		reverse_proxy server:8080
	}

	# The agent endpoint (docs/API.md section 3, docs/MCP_SPEC.md section 3.2).
	# It is a separate route to a separate process, which is what
	# docs/ARCHITECTURE.md section 4.4 asks for: a misconfiguration that exposed
	# the human API cannot expose the agent one as a side effect, and the two
	# have different bodies, different credentials and different limits.
	handle /mcp/* {
		request_body {
			# An MCP request is a JSON-RPC message. Nothing an agent sends is
			# large: evidence travels the other way, as a link.
			max_size 1MB
		}
		reverse_proxy mcp-server:8081
	}

	# Everything else is the single-page application. Unknown paths fall back to
	# the document, because routing is client-side (ADR-0011).
	handle {
		root * /srv/web
		encode zstd gzip
		try_files {path} /index.html
		file_server
	}
}
