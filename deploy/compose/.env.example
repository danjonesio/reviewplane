# Compose settings that are not secrets. Copy to `.env` and edit.
# Secret material never belongs here: it goes in `secrets/`, mounted as files
# (docs/CONFIGURATION.md section 7).

# Host port the gateway publishes. It is the only published port in the stack.
REVIEWPLANE_GATEWAY_PORT=8443

# Public origin the web application is served from. The control plane accepts a
# live-view WebSocket upgrade only from this origin, so it must match what a
# browser's address bar shows (docs/API.md section 18.2).
REVIEWPLANE_PUBLIC_ORIGIN=https://localhost:8443

# Concurrent browser sessions the single Stage 0 worker accepts.
REVIEWPLANE_WORKER_CAPACITY=4

# Wall-clock lifetime of a browser session, in seconds.
REVIEWPLANE_WORKER_SESSION_DURATION_SECONDS=7200

# Chromium sandbox posture. `required` is the only supported value;
# `disabled_high_risk` exists so that an operator who disables it has to say so
# by name and sees the startup warning (docs/SECURITY.md section 10).
REVIEWPLANE_WORKER_SANDBOX=required
