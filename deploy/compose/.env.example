# Compose settings that are not secrets. `docs/DEPLOYMENT.md` section 8 copies
# this to `.env` and `./configure` fills in the generated values.
#
# Secret material never belongs here: it goes in `secrets/`, mounted as files
# (`docs/CONFIGURATION.md` section 7, `docs/DEPLOYMENT.md` section 7). Nothing
# in this file is a credential, and nothing in it needs editing for a
# single-host installation on `localhost` to work.

# ---------------------------------------------------------------------------
# Release
# ---------------------------------------------------------------------------

# The release this installation runs. It is the tag every ReviewPlane image
# carries and the value `/version` and `reviewplane status` report. Pinning it
# here rather than leaving it to a floating tag is what makes an upgrade a
# visible edit (`docs/DEPLOYMENT.md` section 2).
REVIEWPLANE_VERSION=0.1.0

# Where the images come from. `./configure` asks the registry whether the
# release above is published: if it is, the images are pulled; if it is not,
# they are built from the checkout and REVIEWPLANE_PULL_POLICY below is set to
# `build`.
REVIEWPLANE_IMAGE_PREFIX=ghcr.io/danjonesio

# `missing` pulls the pinned images; `build` builds them from this checkout.
# `./configure` writes this — do not guess it by hand.
REVIEWPLANE_PULL_POLICY=build

# The revision and build time stamped into the images and reported by
# `/version`. `./configure` writes both when it builds from a checkout.
REVIEWPLANE_REVISION=unknown
REVIEWPLANE_BUILT_AT=unknown

# ---------------------------------------------------------------------------
# Edge gateway
# ---------------------------------------------------------------------------

# Host port the gateway publishes. It is the only published port in the stack.
REVIEWPLANE_GATEWAY_PORT=8443

# The name the gateway serves the site under. It is not decoration: a site
# address that names no host gives the certificate authority no subject to issue
# for, and every TLS handshake fails while the port stays open
# (`docs/CONFIGURATION.md` section 3.2).
REVIEWPLANE_GATEWAY_DOMAIN=localhost

# What terminates TLS: `internal` (Caddy's own authority, the default), an ACME
# account email, or a certificate and key path pair separated by a space. An
# operator who terminates TLS in a reverse proxy in front of this stack leaves
# this alone and points their proxy at REVIEWPLANE_GATEWAY_PORT.
REVIEWPLANE_GATEWAY_TLS=internal

# Public origin the web application is served from. The control plane accepts a
# live-view WebSocket upgrade only from this origin, so it must match what a
# browser's address bar shows (`docs/API.md` section 18.2) and therefore
# REVIEWPLANE_GATEWAY_DOMAIN and REVIEWPLANE_GATEWAY_PORT above.
REVIEWPLANE_PUBLIC_ORIGIN=https://localhost:8443

# The TLS listener whose certificate expiry `reviewplane status` reports
# (`docs/OPERATIONS.md` section 3). Clear it when TLS is terminated in front of
# this stack, and the section reports "not configured" rather than a failure.
REVIEWPLANE_STATUS_TLS_ENDPOINT=gateway:8443

# ---------------------------------------------------------------------------
# Browser worker
# ---------------------------------------------------------------------------

# Concurrent browser sessions the single Stage 1 worker accepts. Chromium is the
# memory-hungry part of this deployment: budget roughly 1 GB per concurrent
# session on top of the base install (`docs/DEPLOYMENT.md` section 9).
REVIEWPLANE_WORKER_CAPACITY=4

# Memory ceiling for the worker container, which is what actually bounds the
# capacity above.
REVIEWPLANE_WORKER_MEMORY_LIMIT=4g

# Wall-clock lifetime of a browser session, in seconds.
REVIEWPLANE_WORKER_SESSION_DURATION_SECONDS=7200

# Chromium sandbox posture. `required` is the only supported value;
# `disabled_high_risk` exists so that an operator who disables it has to say so
# by name and sees the startup warning (`docs/SECURITY.md` section 10).
REVIEWPLANE_WORKER_SANDBOX=required

# ---------------------------------------------------------------------------
# Generated
# ---------------------------------------------------------------------------

# The browser worker pins the tunnel gateway's public key rather than trusting
# an authority (ADR-0015). `./configure` issues the certificate and writes the
# pin here; rotating the certificate changes this value.
REVIEWPLANE_TUNNEL_CERTIFICATE_SPKI=
