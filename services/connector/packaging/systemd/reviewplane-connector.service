# ReviewPlane development-environment connector.
#
# Installed per docs/DEPLOYMENT.md section 13, with the paths of
# docs/CONNECTOR_PROTOCOL.md section 3:
#
#   /usr/local/bin/reviewplane-connector
#   /etc/reviewplane-connector/config.yaml
#   /var/lib/reviewplane-connector/
#
# This unit opens NO LISTENING SOCKET. The connector's only connections are
# outbound, mutually authenticated TLS channels to the control plane and the
# tunnel gateway (docs/CONNECTOR_PROTOCOL.md section 5, ADR-0002), which is the
# mechanism behind the Stage 0 exit criterion "No public inbound port is
# required on the development VM". A build-time guard in
# cmd/reviewplane-connector asserts the same claim about the source, and
# "ss -ltnp" is its observable form on a running machine. No socket unit
# accompanies this one, and adding one would be an architecture change
# requiring an ADR.
#
# The connector is not a remote shell, a VPN, a filesystem synchronisation
# service or a source-code uploader (section 2). The hardening below is written
# to keep it that way even if a future change forgot.

[Unit]
Description=ReviewPlane connector
Documentation=https://github.com/danjonesio/reviewplane/blob/main/docs/CONNECTOR_PROTOCOL.md
# The channel is outbound and retried under bounded backoff, so the connector
# does not need the network to be up to start; it needs it to be up eventually.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/reviewplane-connector run
Restart=on-failure
RestartSec=5s
# Exit code 3 is a refusal an operator must act on — an invalid enrolment
# token, a revoked identity, an unsupported protocol version or a required
# upgrade. Restarting on it would retry a credential the control plane has
# already refused, which section 18 forbids, so it is excluded from Restart=.
RestartPreventExitStatus=3

# A dedicated system account, created once by the administrator:
#
#   sudo useradd --system --home-dir /var/lib/reviewplane-connector \
#     --shell /usr/sbin/nologin reviewplane-connector
#
# DynamicUser= is deliberately NOT used, although it would be tidier. The
# connector reads the developer's workspace checkouts to report branch and head
# commit (docs/CONNECTOR_PROTOCOL.md section 9), and that needs a stable
# identity in two ways a per-boot UID cannot provide: the checkouts must grant
# it read access, and Git refuses to operate on a repository owned by another
# account unless safe.directory names it, which is configuration written
# against a specific user.
#
# Grant that read access explicitly rather than widening the account. Either add
# the developer's group here:
#
#   sudo systemctl edit reviewplane-connector
#   [Service]
#   SupplementaryGroups=dan
#
# or run the connector as the developer, which on a single-developer machine is
# the honest arrangement:
#
#   [Service]
#   User=dan
#   Group=dan
User=reviewplane-connector
Group=reviewplane-connector

# /etc/reviewplane-connector, created 0750 and owned by the service account.
ConfigurationDirectory=reviewplane-connector
ConfigurationDirectoryMode=0750
# /var/lib/reviewplane-connector, created 0700. The device private key lives
# here and the connector refuses to start if it is readable by group or other
# (docs/SECURITY.md section 6.2, docs/DEVELOPMENT.md section 10), so the mode is
# not decoration.
StateDirectory=reviewplane-connector
StateDirectoryMode=0700

NoNewPrivileges=yes
# The whole filesystem is read-only apart from StateDirectory. The connector
# writes its identity and nothing else.
ProtectSystem=strict
# read-only rather than yes: workspace checkouts commonly live under /home, and
# ProtectHome=yes would make /home appear empty to this service, so every
# workspace would be reported as "not a Git checkout" and the whole of section 9
# would silently do nothing. read-only still means an observation cannot write
# to somebody's repository, which the connector also enforces from its side with
# GIT_OPTIONAL_LOCKS=0 and gc.auto=0.
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Other processes' entries are hidden. ProcSubset=pid is deliberately NOT set:
# the heartbeat's resource summary reads /proc/loadavg and /proc/meminfo, which
# are the only two values section 8 permits it to report, and ProcSubset=pid
# would hide them.
ProtectProc=invisible
# Outbound TLS over IPv4 and IPv6, and AF_UNIX for journald. Nothing else: the
# connector is not a VPN and has no reason to speak a raw or packet family. A
# build linked against the system resolver rather than Go's own may additionally
# need AF_NETLINK; this unit assumes the statically linked binary of section 3.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RemoveIPC=yes
UMask=0077
# Capabilities are dropped entirely. The connector binds nothing, so it needs
# none, including CAP_NET_BIND_SERVICE.
CapabilityBoundingSet=
AmbientCapabilities=

# Structured JSON on stderr, collected by journald
# (docs/ARCHITECTURE.md section 15).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=reviewplane-connector

[Install]
WantedBy=multi-user.target
